using stdio;
using async;

namespace test_new_array_advanced;

public static func FillArray() -> int[]
{
    result := new int[3];
    result[0] = 10;
    result[1] = 20;
    result[2] = 30;
    return result;
}

public static async func FillAsync() -> ValueTask<int[]>
{
    arr := new int[2];
    arr[0] = 1;
    arr[1] = 2;
    await Task.Delay(10);
    arr[0] = arr[0] + 10;
    return arr;
}

public static func Main() -> void
{
    numbers := FillArray();
    println(numbers.Length);
    println(numbers[1]);

    task := FillAsync();
    ValueTask.Wait(task);
    asyncResult := task.Result;
    println(asyncResult.Length);
    println(asyncResult[0]);
    println(asyncResult[1]);

    empty := new byte[0];
    println(empty.Length);

    println("done");
}
