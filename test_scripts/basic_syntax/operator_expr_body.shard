using stdio;

namespace operator_expr_body_test;

public class Box
{
    public Value: int;

    public init(value: int)
    {
        this.Value = value;
    }

    public static operator +(a: Box, b: Box) -> Box => new Box(a.Value + b.Value);
}

public class Program
{
    public static func Main() -> void
    {
        a := new Box(5);
        b := new Box(10);
        c := a + b;
        println(c.Value);
    }
}
