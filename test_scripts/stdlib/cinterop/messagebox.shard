// ============================================================================
//  cinterop example: call GetCommandLineW from kernel32.dll
//
//  Exercises the three parts of the `interop` library:
//    - NativeLibrary : load a DLL and resolve exported function pointers
//    - Marshal       : marshal native strings
//    - NativeCall    : invoke a raw C function pointer
//
//  C signature being called:
//
//      LPWSTR GetCommandLineW();
//
//  This replaces the previous MessageBoxW example, which blocked the test
//  runner waiting for a user to click the OK button.
// ============================================================================

using stdio;
using interop;

namespace examples;

public static func Main() -> void
{
    // 1. Load kernel32.dll and resolve the address of GetCommandLineW.
    kernel32 := NativeLibrary.Load("kernel32.dll");
    defer NativeLibrary.Free(kernel32);

    // 2. Invoke GetCommandLineW. It returns a pointer to a UTF-16 string
    //    owned by Windows; we must not free it.
    getCommandLine := NativeLibrary.GetFunction(kernel32, "GetCommandLineW");
    cmdLinePtr := NativeCall.CallN(getCommandLine);

    // 3. Read the UTF-16 string from the returned pointer and print it.
    cmdLine := Marshal.StringFromUnicode(cmdLinePtr);
    println(cmdLine);
}
