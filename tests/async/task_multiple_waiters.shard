using stdio;

async func WaitFor(source: TaskCompletionSource<int>, id: int) -> void
{
    value := await source.task;
    println(id + value);
}

func Main() -> void
{
    source := new TaskCompletionSource<int>();
    first := WaitFor(source, 1);
    second := WaitFor(source, 2);
    await Task.Delay(10);
    source.SetResult(10);
    await first;
    await second;
}
