using stdio;

struct Box
{
    public Amount: int;
}

func Echo(value: int?) -> int?
{
    return value;
}

func Safe(value: int?) -> int
{
    if (value == null)
    {
        return 0;
    }

    return value;
}

func Main() -> void
{
    a: int? = 5;
    b: int? = null;
    println(a != null);
    println(b != null);
    println(a);
    println(Safe(7));
    println(Safe(null));

    c: int? = a;
    c = null;
    println(a != null);

    box: Box = new Box();
    box.Amount = 7;
    maybeBox: Box? = box;
    if (maybeBox != null)
    {
        println(maybeBox.Amount);
    }

    e: int? = Echo(9);
    if (e != null)
    {
        println(e);
    }
}
