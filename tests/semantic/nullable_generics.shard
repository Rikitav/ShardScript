using stdio;

struct Box<T>
{
    public Item: T?;
}

func Maybe<T>(value: T?) -> T?
{
    return value;
}

func Force<T>(value: T?, fallback: T) -> T
{
    return value ?? fallback;
}

func Main() -> void
{
    a: int? = Maybe<int>(5);
    println(a ?? 0);

    b: int? = Maybe<int>(null);
    println(b != null);

    box: Box<int> = new Box<int>();
    box.Item = 9;
    println(box.Item ?? 0);

    nested: Box<int?> = new Box<int?>();
    nested.Item = null;
    println(nested.Item != null);

    println(Force<int>(a, 0));
}
