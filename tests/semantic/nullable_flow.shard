func Positive(value: int) -> bool
{
    return value > 0;
}

func Read(x: int?) -> int
{
    if (x == null)
    {
        return 0;
    }

    a: int = x;

    if (x != null)
    {
        b: int = x;
    }

    if (x != null)
    {
        c: int = x;
    }

    if (x != null and Positive(x))
    {
        d: int = x;
    }

    e: int = x ?? 0;
    return a;
}
