using stdio;

struct Payload
{
    public N: int;
}

struct Holder
{
    public Value: int?;
    public Ref: Payload?;
}

func Churn() -> void
{
    for i in 0..40000
    {
        junk: int[] = new int[256];
        junk[0] = i;
    }
}

func Main() -> void
{
    h: Holder = new Holder();
    h.Value = 123;
    h.Ref = new Payload();

    refLocal: Payload? = h.Ref;
    if (refLocal != null)
    {
        refLocal.N = 42;
    }

    Churn();
    println(h.Value ?? 0);

    refAfter: Payload? = h.Ref;
    if (refAfter != null)
    {
        println(refAfter.N);
    }

    p: Payload? = new Payload();
    if (p != null)
    {
        p.N = 7;
    }

    Churn();
    if (p != null)
    {
        println(p.N);
    }

    items: Payload?[] = new Payload?[1];
    items[0] = new Payload();

    itemLocal: Payload? = items[0];
    if (itemLocal != null)
    {
        itemLocal.N = 9;
    }

    Churn();
    itemAfter: Payload? = items[0];
    if (itemAfter != null)
    {
        println(itemAfter.N);
    }
}
