using stdio;

struct Record
{
    public Count: int?;
    public Tag: string;
    public Tail: int;
}

struct Bag
{
    public static Slot: int?;
}

func Main() -> void
{
    r: Record = new Record();
    r.Count = 7;
    r.Tag = "x";
    r.Tail = 9;
    println(r.Count != null);
    println(r.Count ?? 0);
    println(r.Tail);
    println(r.Tag);

    r.Count = null;
    println(r.Count != null);

    values: int?[] = new int?[3];
    values[0] = 1;
    values[1] = null;
    values[2] = 3;
    println(values.Length);
    println(values[0] ?? -1);
    println(values[1] != null);
    println(values[2] ?? -1);

    println(Bag.Slot != null);
    Bag.Slot = 11;
    println(Bag.Slot ?? -1);
}
